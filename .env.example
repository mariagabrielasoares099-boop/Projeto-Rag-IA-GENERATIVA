# Configuração do Supabase (pgvector)
SUPABASE_URL=https://sua-url-aqui.supabase.co
SUPABASE_SECRET_KEY=sb_secret_sua_chave_secreta_aqui
SUPABASE_PUBLISHABLE_KEY=sb_publishable_sua_chave_publica_aqui

# Provedor de LLM (OpenRouter)
OPENROUTER_API_KEY=sk-or-v1-sua_chave_openrouter_aqui
OPENROUTER_MODEL=openrouter/auto

# Modelo de embedding do FastEmbed (precisa ter 384 dimensões para a tabela vector(384)).
# Se trocar, rode a ingestão de novo.
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
